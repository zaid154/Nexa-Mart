  "author": "Mohd Zaid <trendykart.app@gmail.com> (https://github.com/zaid154)",
  "description": "Electronics e-commerce marketplace (MERN)",
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix client",
    "dev": "node dev.js",
    "seed": "npm run seed --prefix server",
